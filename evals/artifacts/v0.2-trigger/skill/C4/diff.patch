diff --git a/src/task_service/notifications.py b/src/task_service/notifications.py
index 1c07d24..18c79c2 100644
--- a/src/task_service/notifications.py
+++ b/src/task_service/notifications.py
@@ -1,4 +1,6 @@
 from typing import Protocol
+import json
+from urllib.request import Request, urlopen
 
 from .domain import Task
 
@@ -7,7 +9,22 @@ class Notifier(Protocol):
     def task_completed(self, task: Task) -> None: ...
 
 
-class ConsoleNotifier:
+class WebhookNotifier:
+    def __init__(self, url: str) -> None:
+        if not url:
+            raise ValueError("webhook URL is required")
+        self._url = url
+
     def task_completed(self, task: Task) -> None:
-        print(f"Task completed: {task.title}")
+        payload = json.dumps(
+            {"event": "task_completed", "task": {"id": task.id, "title": task.title}}
+        ).encode("utf-8")
+        request = Request(
+            self._url,
+            data=payload,
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urlopen(request) as response:
+            response.read()
 
