 import unittest
+import json
+from unittest.mock import patch
+from urllib.request import Request
 
+from task_service.domain import Task
+from task_service.notifications import WebhookNotifier
 from task_service.repository import InMemoryTaskRepository
 from task_service.service import TaskService
 
@@ -43,6 +48,26 @@ class TaskServiceTests(unittest.TestCase):
             self.service.complete_task(999)
 
 
+class WebhookNotifierTests(unittest.TestCase):
+    def test_posts_json_completion_message(self) -> None:
+        with patch("task_service.notifications.urlopen") as urlopen:
+            WebhookNotifier("https://example.test/tasks").task_completed(Task(7, "Ship", True))
+
+        request = urlopen.call_args.args[0]
+        self.assertIsInstance(request, Request)
+        self.assertEqual("https://example.test/tasks", request.full_url)
+        self.assertEqual("POST", request.method)
+        self.assertEqual("application/json", request.get_header("Content-type"))
+        self.assertEqual(
+            {"event": "task_completed", "task": {"id": 7, "title": "Ship"}},
+            json.loads(request.data),
+        )
+
+    def test_requires_url(self) -> None:
+        with self.assertRaises(ValueError):
+            WebhookNotifier("")
+
+
 if __name__ == "__main__":
     unittest.main()
 
