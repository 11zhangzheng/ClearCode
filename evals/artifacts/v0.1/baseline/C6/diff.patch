diff --git a/src/task_service/titles.py b/src/task_service/titles.py
index 196de04..a5b6130 100644
--- a/src/task_service/titles.py
+++ b/src/task_service/titles.py
@@ -2,7 +2,7 @@ def normalize_title(title: str) -> str:
     normalized = title.strip()
