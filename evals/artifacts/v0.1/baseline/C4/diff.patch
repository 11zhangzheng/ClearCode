-from typing import Protocol
+import json
+from typing import Callable, Protocol
+from urllib.request import Request, urlopen
 
 from .domain import Task
 
@@ -7,7 +9,31 @@ class Notifier(Protocol):
     def task_completed(self, task: Task) -> None: ...
 
 
-class ConsoleNotifier:
-    def task_completed(self, task: Task) -> None:
-        print(f"Task completed: {task.title}")
+HttpPost = Callable[[str, bytes], None]
+
+
+def _post_json(url: str, body: bytes) -> None:
+    request = Request(
+        url,
+        data=body,
+        headers={"Content-Type": "application/json"},
+        method="POST",
+    )
+    with urlopen(request) as response:
+        response.read()
 
+
+class WebhookNotifier:
+    def __init__(self, url: str, post: HttpPost = _post_json) -> None:
+        if not url.strip():
+            raise ValueError("webhook URL must not be empty")
+        self._url = url
+        self._post = post
+
+    def task_completed(self, task: Task) -> None:
+        payload = {
+            "event": "task.completed",
+            "task": {"id": task.id, "title": task.title, "done": task.done},
+        }
+        body = json.dumps(payload).encode("utf-8")
+        self._post(self._url, body)
