+class WebhookNotifierTests(unittest.TestCase):
+    def test_posts_json_completion_message_to_configured_url(self) -> None:
+        requests: list[tuple[str, bytes]] = []
+        notifier = WebhookNotifier(
+            "https://example.test/hooks/tasks",
+            post=lambda url, body: requests.append((url, body)),
+        )
+
+        notifier.task_completed(Task(7, "Ship", done=True))
+
+        self.assertEqual(1, len(requests))
+        url, body = requests[0]
+        self.assertEqual("https://example.test/hooks/tasks", url)
+        self.assertEqual(
+            {
+                "event": "task.completed",
+                "task": {"id": 7, "title": "Ship", "done": True},
+            },
+            json.loads(body),
+        )
+
+    def test_rejects_empty_webhook_url(self) -> None:
+        with self.assertRaises(ValueError):
+            WebhookNotifier("  ")
+
+
 if __name__ == "__main__":
     unittest.main()
 
