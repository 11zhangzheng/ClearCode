+"""A small in-memory task service with completion callbacks."""
+
+from dataclasses import dataclass
+from typing import Callable
+
+
+@dataclass
+class Task:
+    id: int
+    title: str
+    done: bool = False
+
+
+CompletionListener = Callable[[Task], None]
+
+
+class TaskService:
+    """Create and complete tasks, notifying listeners when they finish."""
+
+    def __init__(self) -> None:
+        self._tasks: dict[int, Task] = {}
+        self._next_id = 1
+        self._listeners: list[CompletionListener] = []
+
+    def add_completion_listener(self, listener: CompletionListener) -> None:
+        """Register a callback that receives each task when it is completed."""
+        self._listeners.append(listener)
+
+    def create_task(self, title: str) -> Task:
+        """Create and store a task with a non-empty title."""
+        if not isinstance(title, str) or not title.strip():
+            raise ValueError("title must be a non-empty string")
+        task = Task(id=self._next_id, title=title.strip())
+        self._tasks[task.id] = task
+        self._next_id += 1
+        return task
+
+    def get_task(self, task_id: int) -> Task:
+        """Return a stored task or raise KeyError if it does not exist."""
+        return self._tasks[task_id]
+
+    def mark_done(self, task_id: int) -> Task:
+        """Mark a task complete and notify listeners once, on first completion."""
+        task = self.get_task(task_id)
+        if not task.done:
+            task.done = True
+            for listener in tuple(self._listeners):
+                listener(task)
+        return task
