@@ -0,0 +1,37 @@
+import unittest
+
+from task_service import TaskService
+
+
+class TaskServiceTests(unittest.TestCase):
+    def test_create_store_and_notify_on_completion(self) -> None:
+        service = TaskService()
+        notifications = []
+        service.add_completion_listener(notifications.append)
+
+        created = service.create_task("  Write tests  ")
+
+        self.assertEqual(created.title, "Write tests")
+        self.assertFalse(created.done)
+        self.assertIs(service.get_task(created.id), created)
+        self.assertEqual(notifications, [])
+
+        completed = service.mark_done(created.id)
+
+        self.assertTrue(completed.done)
+        self.assertIs(notifications[0], completed)
+        self.assertEqual(len(notifications), 1)
+
+        service.mark_done(created.id)
+        self.assertEqual(len(notifications), 1)
+
+    def test_rejects_empty_title_and_unknown_task(self) -> None:
+        service = TaskService()
+        with self.assertRaises(ValueError):
+            service.create_task("  ")
+        with self.assertRaises(KeyError):
+            service.mark_done(999)
+
+
+if __name__ == "__main__":
+    unittest.main()
