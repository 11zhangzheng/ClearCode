+from dataclasses import dataclass
+from typing import Callable
+
+
+@dataclass
+class Task:
+    id: int
+    title: str
+    done: bool = False
+
+
+CompletionListener = Callable[[Task], None]
+
+
+class TaskService:
+    """Store tasks in memory and notify listeners when one is completed."""
+
+    def __init__(self, on_completed: CompletionListener | None = None) -> None:
+        self._tasks: dict[int, Task] = {}
+        self._next_id = 1
+        self._on_completed = on_completed
+
+    def create_task(self, title: str) -> Task:
+        title = title.strip()
+        if not title:
+            raise ValueError("title must not be empty")
+
+        task = Task(id=self._next_id, title=title)
+        self._tasks[task.id] = task
+        self._next_id += 1
+        return task
+
+    def mark_done(self, task_id: int) -> Task:
+        try:
+            task = self._tasks[task_id]
+        except KeyError:
+            raise KeyError(f"task {task_id} does not exist") from None
+
+        if not task.done:
+            task.done = True
+            if self._on_completed is not None:
+                self._on_completed(task)
+        return task
+
+    def get_task(self, task_id: int) -> Task:
+        try:
+            return self._tasks[task_id]
+        except KeyError:
+            raise KeyError(f"task {task_id} does not exist") from None
