@@ -0,0 +1,33 @@
+import unittest
+
+from task_service import TaskService
+
+
+class TaskServiceTests(unittest.TestCase):
+    def test_create_and_complete_notifies_once(self):
+        completed = []
+        service = TaskService(on_completed=completed.append)
+
+        task = service.create_task("  Write tests  ")
+        self.assertEqual(task.title, "Write tests")
+        self.assertIs(service.get_task(task.id), task)
+
+        result = service.mark_done(task.id)
+        service.mark_done(task.id)
+
+        self.assertTrue(result.done)
+        self.assertEqual(completed, [task])
+
+    def test_rejects_empty_title(self):
+        service = TaskService()
+        with self.assertRaises(ValueError):
+            service.create_task("  ")
+
+    def test_unknown_task_has_clear_error(self):
+        service = TaskService()
+        with self.assertRaisesRegex(KeyError, "task 10 does not exist"):
+            service.mark_done(10)
+
+
+if __name__ == "__main__":
+    unittest.main()
