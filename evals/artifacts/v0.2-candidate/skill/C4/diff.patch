+class WebhookNotifierTests(unittest.TestCase):
+    def test_posts_json_completion_message(self) -> None:
+        captured = {}
+
+        class Response:
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *args):
+                return False
+
+            def read(self):
+                return b""
+
+        def opener(request):
+            captured["url"] = request.full_url
+            captured["method"] = request.get_method()
+            captured["content_type"] = request.get_header("Content-type")
+            captured["body"] = json.loads(request.data.decode("utf-8"))
+            return Response()
+
+        WebhookNotifier("https://example.test/completed", opener).task_completed(
+            Task(id=7, title="Ship it", done=True)
+        )
+
+        self.assertEqual("https://example.test/completed", captured["url"])
+        self.assertEqual("POST", captured["method"])
+        self.assertEqual("application/json", captured["content_type"])
+        self.assertEqual(
+            {"event": "task_completed", "task_id": 7, "title": "Ship it"},
+            captured["body"],
+        )
+
+
 if __name__ == "__main__":
     unittest.main()
 
