+class WebhookNotifierTests(unittest.TestCase):
+    @patch("task_service.notifications.urlopen")
+    def test_posts_task_completion_as_json(self, urlopen) -> None:
+        response = urlopen.return_value.__enter__.return_value
+        notifier = WebhookNotifier("https://example.test/hook")
+
+        notifier.task_completed(Task(7, "Ship release", True))
+
+        request = urlopen.call_args.args[0]
+        self.assertIsInstance(request, Request)
+        self.assertEqual("POST", request.method)
+        self.assertEqual("application/json", request.get_header("Content-type"))
+        self.assertEqual(
+            {"event": "task.completed", "task": {"id": 7, "title": "Ship release"}},
+            json.loads(request.data),
+        )
+        response.read.assert_called_once_with()
+
+    def test_requires_webhook_url(self) -> None:
+        with self.assertRaises(ValueError):
+            WebhookNotifier("")
+
+
 if __name__ == "__main__":
     unittest.main()
 
